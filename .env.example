# Server Environment
PORT=5001
NODE_ENV=production

# RateGuard Live Demo Configuration (Optional overrides)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# Optional CORS Origin (Leave unset or * for same-origin single deployment)
# CORS_ORIGIN=https://your-domain.com

# Optional Frontend API Base URL (Leave empty for same-origin single deployment)
# VITE_API_BASE_URL=
