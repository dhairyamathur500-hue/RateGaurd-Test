{
  "name": "rateguard-app",
  "version": "1.0.0",
  "description": "Full-stack single-deployment application for RateGuard (rateguard-dhairyamathur)",
  "main": "backend/server.js",
  "scripts": {
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "postinstall": "npm run install:all",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "build:all": "npm run install:all && npm run build:frontend",
    "start": "node backend/server.js",
    "dev:backend": "node backend/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "node backend/server.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "rateguard",
    "rate-limit",
    "express",
    "middleware",
    "react",
    "nodejs",
    "fullstack"
  ],
  "author": "Dhairya Mathur",
  "license": "MIT"
}
